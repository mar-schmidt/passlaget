{
  "name": "passlaget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run && PGLITE_MODULE=@electric-sql/pglite node --test apps-script/worker.test.mjs scripts/restore-backup.test.mjs && node supabase/tests/sql-smoke.mjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run test && npm run build",
    "format": "prettier --write src docs apps-script/*.mjs scripts/*.mjs *.json *.ts *.md deployment/*.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
