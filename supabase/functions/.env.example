# Local development only. Copy to an ignored .env.local file.
# Hosted Edge Functions receive SUPABASE_URL and SUPABASE_SECRET_KEYS automatically.
# PORTAL_SUPABASE_SECRET_KEY may override the default secret key for local testing.
PORTAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173/
# Keep false until a mail sender is configured. Core planning needs no mail secrets.
MAIL_ENABLED=false
# Required only when MAIL_ENABLED=true: independent random secrets of at least 32 characters.
# Never use VITE_ variables. Retain MAIL_TOKEN_SECRET when pausing established mail
# so existing opt-out links can still work.
MAIL_WORKER_SECRET=
MAIL_TOKEN_SECRET=
