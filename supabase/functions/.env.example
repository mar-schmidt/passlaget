# Local development only. Copy to an ignored .env.local file.
# Hosted Edge Functions receive SUPABASE_URL and SUPABASE_SECRET_KEYS automatically.
# PORTAL_SUPABASE_SECRET_KEY may override the default secret key for local testing.
PORTAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173/
# Independent random secrets, at least 32 characters each. Never VITE_ variables.
MAIL_WORKER_SECRET=replace-with-a-long-random-secret
MAIL_TOKEN_SECRET=replace-with-a-different-long-random-secret
